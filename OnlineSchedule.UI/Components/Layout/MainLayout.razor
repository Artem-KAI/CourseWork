@inherits LayoutComponentBase

@inject UserSessionService Session
@inject NavigationManager Navigation

<div class="page">

    @if (Session.IsAuthenticated)
    {
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

            <div class="container-fluid">

                <span class="navbar-brand">
                    Electronic Schedule
                </span>

                <div class="navbar-nav">

                    <a class="nav-link"
                       href="/">
                        Home
                    </a>

                    <a class="nav-link"
                       href="/schedule">
                        Schedule
                    </a>

                    @if (Session.IsManagement || Session.IsAdmin)
                    {
                        <a class="nav-link"
                           href="/statistics">
                            Statistics
                        </a>
                    }

                    @if (Session.IsAdmin)
                    {
                        <a class="nav-link"
                           href="/users">
                            Users
                        </a>

                        <a class="nav-link"
                           href="/admin">
                            Administration
                        </a>
                    }

                    @if (Session.IsEditor)
                    {
                        <a class="nav-link"
                           href="/admin">
                            Editor Panel
                        </a>
                    }

                </div>

                <div>

                    <span class="text-light me-3">

                        @Session.CurrentUser?.Username

                        (
                        @Session.CurrentUser?.Role
                        )

                    </span>

                    <button class="btn btn-danger"
                            @onclick="Logout">
                        Logout
                    </button>

                </div>

            </div>

        </nav>
    }

    <main class="container mt-4">

        @Body

    </main>

</div>

@code {

    private void Logout()
    {
        Session.Logout();

        Navigation.NavigateTo("/");
    }

}