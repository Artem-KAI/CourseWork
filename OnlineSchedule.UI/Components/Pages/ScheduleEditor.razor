@page "/schedule-editor"

@using CONTRACT.DTO
@rendermode @(new InteractiveServerRenderMode())

@inject ApiScheduleService ScheduleService
@inject NavigationManager Navigation
@inject UserSessionService Session

<div class="container-fluid py-4" style="font-family: 'Outfit', 'Segoe UI', sans-serif; background-color: #f8f9fa; min-height: 100vh;">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <button class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2 shadow-sm"
                @onclick="GoBack" style="border-radius: 8px; font-weight: 500;">
            <i class="bi bi-arrow-left"></i> ← Back to Schedule
        </button>
        <h2 class="text-dark m-0" style="font-weight: 700; letter-spacing: -0.5px;">Schedule Management Console</h2>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center shadow-sm border-0 mb-4" role="alert" style="border-radius: 12px; background-color: #fff5f5; color: #e53e3e;">
            <div class="flex-grow-1">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
            </div>
            <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success d-flex align-items-center shadow-sm border-0 mb-4" role="alert" style="border-radius: 12px; background-color: #f0fff4; color: #38a169;">
            <div class="flex-grow-1">
                <i class="bi bi-check-circle-fill me-2"></i> @successMessage
            </div>
            <button type="button" class="btn-close" @onclick="() => successMessage = null" aria-label="Close"></button>
        </div>
    }

    <!-- Tab Navigation -->
    <ul class="nav nav-pills mb-4 gap-2 shadow-sm p-2 bg-white" style="border-radius: 12px;">
        <li class="nav-item">
            <button class="nav-link @(activeTab == Tab.Schedule ? "active bg-primary text-white" : "text-secondary")" 
                    @onclick="() => SwitchTab(Tab.Schedule)" style="border-radius: 8px; font-weight: 600;">
                Lessons Schedule
            </button>
        </li>
        @if (Session.IsAdmin)
        {
            <li class="nav-item">
                <button class="nav-link @(activeTab == Tab.Departments ? "active bg-primary text-white" : "text-secondary")" 
                        @onclick="() => SwitchTab(Tab.Departments)" style="border-radius: 8px; font-weight: 600;">
                    Departments
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == Tab.Groups ? "active bg-primary text-white" : "text-secondary")" 
                        @onclick="() => SwitchTab(Tab.Groups)" style="border-radius: 8px; font-weight: 600;">
                    Groups
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == Tab.Teachers ? "active bg-primary text-white" : "text-secondary")" 
                        @onclick="() => SwitchTab(Tab.Teachers)" style="border-radius: 8px; font-weight: 600;">
                    Teachers
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == Tab.Classrooms ? "active bg-primary text-white" : "text-secondary")" 
                        @onclick="() => SwitchTab(Tab.Classrooms)" style="border-radius: 8px; font-weight: 600;">
                    Classrooms
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == Tab.Disciplines ? "active bg-primary text-white" : "text-secondary")" 
                        @onclick="() => SwitchTab(Tab.Disciplines)" style="border-radius: 8px; font-weight: 600;">
                    Disciplines
                </button>
            </li>
        }
    </ul>

    <!-- Tabs Content -->
    <div class="card shadow-sm border-0 p-4" style="border-radius: 16px; background-color: #ffffff;">

        @if (activeTab == Tab.Schedule)
        {
            <!-- LESSON SCHEDULE WORK -->
            <div class="card mb-4 border-0 bg-light" style="border-radius: 12px;">
                <div class="card-header bg-transparent border-0 pt-3 pb-0">
                    <h5 style="font-weight: 700; color: #2d3748;">@(isEditMode ? "Edit Lesson Item" : "Schedule New Lesson")</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label" style="font-weight: 600; color: #4a5568;">Academic Group</label>
                            <select @bind="model.GroupId" class="form-select" style="border-radius: 8px;">
                                <option value="0">Select Group</option>
                                @foreach (var group in groups)
                                {
                                    <option value="@group.Id">@group.Name (@group.DepartmentName)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" style="font-weight: 600; color: #4a5568;">Teacher</label>
                            <select @bind="model.TeacherId" class="form-select" style="border-radius: 8px;">
                                <option value="0">Select Teacher</option>
                                @foreach (var teacher in teachers)
                                {
                                    <option value="@teacher.Id">@teacher.Name (@teacher.DepartmentName - @teacher.Degree)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" style="font-weight: 600; color: #4a5568;">Classroom</label>
                            <select @bind="model.ClassroomId" class="form-select" style="border-radius: 8px;">
                                <option value="0">Select Room</option>
                                @foreach (var classroom in classrooms)
                                {
                                    <option value="@classroom.Id">@classroom.Name (@classroom.Building, Cap: @classroom.Capacity)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" style="font-weight: 600; color: #4a5568;">Discipline</label>
                            <select @bind="model.DisciplineId" class="form-select" style="border-radius: 8px;">
                                <option value="0">Select Discipline</option>
                                @foreach (var discipline in disciplines)
                                {
                                    <option value="@discipline.Id">@discipline.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-4">
                            <label class="form-label" style="font-weight: 600; color: #4a5568;">Day of Week</label>
                            <select class="form-select" @bind="model.DayOfWeek" style="border-radius: 8px;">
                                @foreach (DayOfWeek day in Enum.GetValues<DayOfWeek>())
                                {
                                    <option value="@day">@day</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" style="font-weight: 600; color: #4a5568;">Lesson Number (Pair)</label>
                            <input type="number" class="form-control" @bind="model.LessonNumber" min="1" max="8" style="border-radius: 8px;" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" style="font-weight: 600; color: #4a5568;">Week Type</label>
                            <select class="form-select" @bind="model.WeekType" style="border-radius: 8px;">
                                <option value="Both">Both Weeks</option>
                                <option value="Odd">Odd Week</option>
                                <option value="Even">Even Week</option>
                            </select>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button class="btn btn-success px-4 py-2" @onclick="SaveLesson" style="border-radius: 8px; font-weight: 600;">
                            <i class="bi bi-save"></i> Save Lesson
                        </button>
                        @if (isEditMode)
                        {
                            <button class="btn btn-secondary px-4 py-2" @onclick="ClearForm" style="border-radius: 8px; font-weight: 600;">
                                Cancel
                            </button>
                        }
                    </div>
                </div>
            </div>

            <h5 class="mb-3" style="font-weight: 700; color: #2d3748;">Active Schedule Listings</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle shadow-sm bg-white" style="border-radius: 12px; overflow: hidden;">
                    <thead class="table-primary text-white">
                        <tr>
                            <th>Id</th>
                            <th>Group</th>
                            <th>Teacher</th>
                            <th>Classroom</th>
                            <th>Discipline</th>
                            <th>Day</th>
                            <th>Pair</th>
                            <th>Week</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in scheduleItems)
                        {
                            <tr>
                                <td style="font-weight: 600;">@item.Id</td>
                                <td>@item.GroupName</td>
                                <td>@item.TeacherName</td>
                                <td>@item.ClassroomName</td>
                                <td>@item.DisciplineName</td>
                                <td><span class="badge bg-secondary">@item.DayOfWeek</span></td>
                                <td>@item.LessonNumber</td>
                                <td><span class="badge bg-info text-dark">@item.WeekType</span></td>
                                <td class="text-end">
                                    <button class="btn btn-outline-warning btn-sm me-1" @onclick="() => EditLesson(item)" style="border-radius: 6px;">
                                        Edit
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteLesson(item.Id)" style="border-radius: 6px;">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (activeTab == Tab.Departments)
        {
            <!-- DEPARTMENTS TAB -->
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="p-3 bg-light" style="border-radius: 12px;">
                        <h5 style="font-weight: 700; color: #2d3748;">@(editingDeptId == 0 ? "Add Department" : "Edit Department")</h5>
                        <div class="mb-3">
                            <label class="form-label" style="font-weight: 600;">Department Name</label>
                            <input type="text" class="form-control" @bind="newDepartment.Name" placeholder="e.g. Кафедра ІПЗ" style="border-radius: 8px;" />
                        </div>
                        <button class="btn btn-primary w-100" @onclick="SaveDepartment" style="border-radius: 8px; font-weight: 600;">
                            @(editingDeptId == 0 ? "Add" : "Update") Department
                        </button>
                        @if (editingDeptId != 0)
                        {
                            <button class="btn btn-link w-100 mt-1" @onclick="ClearDeptEdit">Cancel Edit</button>
                        }
                    </div>
                </div>
                <div class="col-md-8">
                    <h5 style="font-weight: 700; color: #2d3748;" class="mb-3">Departments List</h5>
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dep in departments)
                            {
                                <tr>
                                    <td>@dep.Id</td>
                                    <td style="font-weight: 600;">@dep.Name</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-warning me-1" @onclick="() => StartEditDept(dep)">Edit</button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteDepartment(dep.Id)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (activeTab == Tab.Groups)
        {
            <!-- GROUPS TAB -->
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="p-3 bg-light" style="border-radius: 12px;">
                        <h5 style="font-weight: 700; color: #2d3748;">@(editingGroupId == 0 ? "Add Group" : "Edit Group")</h5>
                        <div class="mb-3">
                            <label class="form-label" style="font-weight: 600;">Group Name</label>
                            <input type="text" class="form-control" @bind="newGroup.Name" placeholder="e.g. ПІ-221" style="border-radius: 8px;" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="font-weight: 600;">Department</label>
                            <select @bind="newGroup.DepartmentId" class="form-select" style="border-radius: 8px;">
                                <option value="0">Select Department</option>
                                @foreach (var dep in departments)
                                {
                                    <option value="@dep.Id">@dep.Name</option>
                                }
                            </select>
                        </div>
                        <button class="btn btn-primary w-100" @onclick="SaveGroup" style="border-radius: 8px; font-weight: 600;">
                            @(editingGroupId == 0 ? "Add" : "Update") Group
                        </button>
                        @if (editingGroupId != 0)
                        {
                            <button class="btn btn-link w-100 mt-1" @onclick="ClearGroupEdit">Cancel Edit</button>
                        }
                    </div>
                </div>
                <div class="col-md-8">
                    <h5 style="font-weight: 700; color: #2d3748;" class="mb-3">Groups List</h5>
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Department</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in groups)
                            {
                                <tr>
                                    <td>@g.Id</td>
                                    <td style="font-weight: 600;">@g.Name</td>
                                    <td>@g.DepartmentName</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-warning me-1" @onclick="() => StartEditGroup(g)">Edit</button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteGroup(g.Id)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (activeTab == Tab.Teachers)
        {
            <!-- TEACHERS TAB -->
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="p-3 bg-light" style="border-radius: 12px;">
                        <h5 style="font-weight: 700; color: #2d3748;">@(editingTeacherId == 0 ? "Add Teacher" : "Edit Teacher")</h5>
                        <div class="mb-3">
                            <label class="form-label" style="font-weight: 600;">Full Name</label>
                            <input type="text" class="form-control" @bind="newTeacher.Name" placeholder="e.g. Коваленко І.І." style="border-radius: 8px;" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="font-weight: 600;">Degree</label>
                            <select @bind="newTeacher.Degree" class="form-select" style="border-radius: 8px;">
                                <option value="">Select Degree</option>
                                @foreach (var degree in BLL.Helpers.TeacherDegreeHelper.AllowedDegrees)
                                {
                                    <option value="@degree">@degree</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="font-weight: 600;">Department</label>
                            <select @bind="newTeacher.DepartmentId" class="form-select" style="border-radius: 8px;">
                                <option value="0">Select Department</option>
                                @foreach (var dep in departments)
                                {
                                    <option value="@dep.Id">@dep.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="font-weight: 600;">Linked User Account ID (Optional)</label>
                            <input type="number" class="form-control" @bind="newTeacher.UserId" style="border-radius: 8px;" />
                        </div>
                        <button class="btn btn-primary w-100" @onclick="SaveTeacher" style="border-radius: 8px; font-weight: 600;">
                            @(editingTeacherId == 0 ? "Add" : "Update") Teacher
                        </button>
                        @if (editingTeacherId != 0)
                        {
                            <button class="btn btn-link w-100 mt-1" @onclick="ClearTeacherEdit">Cancel Edit</button>
                        }
                    </div>
                </div>
                <div class="col-md-8">
                    <h5 style="font-weight: 700; color: #2d3748;" class="mb-3">Teachers List</h5>
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Degree</th>
                                <th>Department</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in teachers)
                            {
                                <tr>
                                    <td>@t.Id</td>
                                    <td style="font-weight: 600;">@t.Name</td>
                                    <td>@t.Degree</td>
                                    <td>@t.DepartmentName</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-warning me-1" @onclick="() => StartEditTeacher(t)">Edit</button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteTeacher(t.Id)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (activeTab == Tab.Classrooms)
        {
            <!-- CLASSROOMS TAB -->
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="p-3 bg-light" style="border-radius: 12px;">
                        <h5 style="font-weight: 700; color: #2d3748;">@(editingRoomId == 0 ? "Add Classroom" : "Edit Classroom")</h5>
                        <div class="mb-3">
                            <label class="form-label" style="font-weight: 600;">Classroom Name</label>
                            <input type="text" class="form-control" @bind="newClassroom.Name" placeholder="e.g. 1-305" style="border-radius: 8px;" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="font-weight: 600;">Building</label>
                            <input type="text" class="form-control" @bind="newClassroom.Building" placeholder="e.g. Корпус 1" style="border-radius: 8px;" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="font-weight: 600;">Capacity</label>
                            <input type="number" class="form-control" @bind="newClassroom.Capacity" min="1" style="border-radius: 8px;" />
                        </div>
                        <button class="btn btn-primary w-100" @onclick="SaveClassroom" style="border-radius: 8px; font-weight: 600;">
                            @(editingRoomId == 0 ? "Add" : "Update") Classroom
                        </button>
                        @if (editingRoomId != 0)
                        {
                            <button class="btn btn-link w-100 mt-1" @onclick="ClearRoomEdit">Cancel Edit</button>
                        }
                    </div>
                </div>
                <div class="col-md-8">
                    <h5 style="font-weight: 700; color: #2d3748;" class="mb-3">Classrooms List</h5>
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Building</th>
                                <th>Capacity</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in classrooms)
                            {
                                <tr>
                                    <td>@c.Id</td>
                                    <td style="font-weight: 600;">@c.Name</td>
                                    <td>@c.Building</td>
                                    <td>@c.Capacity students</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-warning me-1" @onclick="() => StartEditRoom(c)">Edit</button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteClassroom(c.Id)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (activeTab == Tab.Disciplines)
        {
            <!-- DISCIPLINES TAB -->
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="p-3 bg-light" style="border-radius: 12px;">
                        <h5 style="font-weight: 700; color: #2d3748;">@(editingDiscId == 0 ? "Add Discipline" : "Edit Discipline")</h5>
                        <div class="mb-3">
                            <label class="form-label" style="font-weight: 600;">Discipline Name</label>
                            <input type="text" class="form-control" @bind="newDiscipline.Name" placeholder="e.g. Бази даних" style="border-radius: 8px;" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="font-weight: 600;">Department Connection</label>
                            <select @bind="newDiscipline.DepartmentId" class="form-select" style="border-radius: 8px;">
                                <option value="0">Select Department</option>
                                @foreach (var dep in departments)
                                {
                                    <option value="@dep.Id">@dep.Name</option>
                                }
                            </select>
                        </div>
                        <button class="btn btn-primary w-100" @onclick="SaveDiscipline" style="border-radius: 8px; font-weight: 600;">
                            @(editingDiscId == 0 ? "Add" : "Update") Discipline
                        </button>
                        @if (editingDiscId != 0)
                        {
                            <button class="btn btn-link w-100 mt-1" @onclick="ClearDiscEdit">Cancel Edit</button>
                        }
                    </div>
                </div>
                <div class="col-md-8">
                    <h5 style="font-weight: 700; color: #2d3748;" class="mb-3">Disciplines List</h5>
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in disciplines)
                            {
                                <tr>
                                    <td>@d.Id</td>
                                    <td style="font-weight: 600;">@d.Name</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-warning me-1" @onclick="() => StartEditDisc(d)">Edit</button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteDiscipline(d.Id)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

    </div>

</div>

@code {
    private enum Tab { Schedule, Departments, Groups, Teachers, Classrooms, Disciplines }
    private Tab activeTab = Tab.Schedule;

    private List<ScheduleItemInfo> scheduleItems = new();
    private CreateScheduleItemRequest model = new();

    private bool isEditMode;
    private int editingId;
    private string? errorMessage;
    private string? successMessage;

    private List<DepartmentInfo> departments = new();
    private List<GroupInfo> groups = new();
    private List<TeacherInfo> teachers = new();
    private List<ClassroomInfo> classrooms = new();
    private List<DisciplineInfo> disciplines = new();

    // References models
    private CreateDepartmentRequest newDepartment = new();
    private CreateGroupRequest newGroup = new();
    private CreateTeacherRequest newTeacher = new();
    private CreateClassroomRequest newClassroom = new();
    private CreateDisciplineRequest newDiscipline = new();

    // Edit states for references
    private int editingDeptId;
    private int editingGroupId;
    private int editingTeacherId;
    private int editingRoomId;
    private int editingDiscId;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated || (!Session.IsAdmin && !Session.IsEditor))
        {
            Navigation.NavigateTo("/schedule");
            return;
        }
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            scheduleItems = await ScheduleService.GetAllScheduleItemsAsync();
            groups = (await ScheduleService.GetGroupsAsync()).ToList();
            teachers = (await ScheduleService.GetTeachersAsync()).ToList();
            classrooms = (await ScheduleService.GetClassroomsAsync()).ToList();
            disciplines = (await ScheduleService.GetDisciplinesAsync()).ToList();
            departments = (await ScheduleService.GetDepartmentsAsync()).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = "Error loading data: " + ex.Message;
        }
    }

    private void SwitchTab(Tab tab)
    {
        activeTab = tab;
        errorMessage = null;
        successMessage = null;
    }

    private void EditLesson(ScheduleItemInfo item)
    {
        isEditMode = true;
        editingId = item.Id;
        model = new CreateScheduleItemRequest
        {
            GroupId = item.GroupId,
            TeacherId = item.TeacherId,
            ClassroomId = item.ClassroomId,
            DisciplineId = item.DisciplineId,
            DayOfWeek = item.DayOfWeek,
            LessonNumber = item.LessonNumber,
            WeekType = item.WeekType
        };
    }

    private async Task SaveLesson()
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            if (model.GroupId == 0 || model.TeacherId == 0 || model.ClassroomId == 0 || model.DisciplineId == 0)
            {
                throw new Exception("Please select a group, teacher, classroom, and discipline.");
            }

            if (isEditMode)
            {
                var request = new UpdateScheduleItemRequest
                {
                    GroupId = model.GroupId,
                    TeacherId = model.TeacherId,
                    ClassroomId = model.ClassroomId,
                    DisciplineId = model.DisciplineId,
                    DayOfWeek = model.DayOfWeek,
                    LessonNumber = model.LessonNumber,
                    WeekType = model.WeekType
                };

                var ok = await ScheduleService.UpdateScheduleItemAsync(editingId, request);
                if (!ok) throw new Exception("API error updating schedule item. Make sure there are no scheduling conflicts.");
                successMessage = "Lesson schedule item updated successfully!";
            }
            else
            {
                var ok = await ScheduleService.CreateScheduleItemAsync(model);
                if (!ok) throw new Exception("API error creating schedule item. Make sure there are no scheduling conflicts.");
                successMessage = "New lesson scheduled successfully!";
            }

            await LoadData();
            ClearForm();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

