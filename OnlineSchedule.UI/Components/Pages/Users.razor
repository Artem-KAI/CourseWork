@page "/users"
@rendermode @(new InteractiveServerRenderMode())

@using CONTRACT.DTO
@using global::UI.Models

@inject ApiUserService UserService
@inject ApiScheduleService ScheduleService
@inject UserSessionService Session
@inject NavigationManager Navigation

<PageTitle>Users</PageTitle>

@if (!Session.IsAuthenticated || !Session.IsAdmin)
{
    <div class="alert alert-danger">
        Access denied.
    </div>
}
else
{
    <h4>Create User</h4>

    <div class="row">

        <div class="col-md-3">
            <label>Username</label>

            <input class="form-control"
                   @bind="NewUser.Username" />
        </div>

        <div class="col-md-3">
            <label>Email</label>

            <input class="form-control"
                   @bind="NewUser.Email" />
        </div>

        <div class="col-md-3">
            <label>Password</label>

            <input type="password"
                   class="form-control"
                   @bind="NewUser.Password" />
        </div>

        <div class="col-md-3">
            <label>Role</label>

            <select class="form-select"
                    @bind="NewUser.Role">

                <option>Student</option>
                <option>Teacher</option>
                <option>Editor</option>
                <option>Management</option>
                <option>Admin</option>

            </select>
        </div>

    </div>

    <button class="btn btn-success mt-3"
            @onclick="CreateUser">
        Create User
    </button>

    <hr />

    <h4>Create Teacher Account</h4>

    <div class="row">

        <div class="col-md-4">

            <label>Teacher</label>

            <select class="form-select"
                    @bind="SelectedTeacherId">

                <option value="0">
                    Select teacher
                </option>

                @foreach (var teacher in Teachers)
                {
                    <option value="@teacher.Id">
                        @teacher.Name
                    </option>
                }

            </select>

        </div>

        <div class="col-md-4">

            <label>Email</label>

            <input class="form-control"
                   @bind="TeacherEmail" />

        </div>

        <div class="col-md-4">

            <label>Password</label>

            <input type="password"
                   class="form-control"
                   @bind="TeacherPassword" />

        </div>

    </div>

    <button class="btn btn-primary mt-3"
            @onclick="CreateTeacherAccount">
        Create Teacher Account
    </button>

    <hr />

    <div class="btn-group mb-3">

        <button class="btn btn-outline-primary"
                @onclick='() => SelectedRole = "All"'>
            All
        </button>

        <button class="btn btn-outline-primary"
                @onclick='() => SelectedRole = "Student"'>
            Students
        </button>

        <button class="btn btn-outline-primary"
                @onclick='() => SelectedRole = "Teacher"'>
            Teachers
        </button>

        <button class="btn btn-outline-primary"
                @onclick='() => SelectedRole = "Editor"'>
            Editors
        </button>

        <button class="btn btn-outline-primary"
                @onclick='() => SelectedRole = "Management"'>
            Management
        </button>

        <button class="btn btn-outline-primary"
                @onclick='() => SelectedRole = "Admin"'>
            Admins
        </button>

    </div>

    <table class="table table-bordered table-striped">

        <thead>

            <tr>
                <th>Id</th>
                <th>Username</th>
                <th>Email</th>
                <th>Role</th>
                <th>Actions</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var user in FilteredUsers)
            {
                <tr>

                    <td>@user.Id</td>

                    <td>

                        @if (EditingUserId == user.Id)
                        {
                            <input class="form-control"
                                   @bind="EditUsername" />
                        }
                        else
                        {
                            @user.Username
                        }

                    </td>

                    <td>

                        @if (EditingUserId == user.Id)
                        {
                            <input class="form-control"
                                   @bind="EditEmail" />
                        }
                        else
                        {
                            @user.Email
                        }

                    </td>

                    <td>

                        @if (EditingUserId == user.Id)
                        {
                            <select class="form-select"
                                    @bind="EditRole">

                                <option>Student</option>
                                <option>Teacher</option>
                                <option>Editor</option>
                                <option>Management</option>
                                <option>Admin</option>

                            </select>
                        }
                        else
                        {
                            @user.Role
                        }

                    </td>

                    <td>

                        @if (EditingUserId == user.Id)
                        {
                            <button class="btn btn-success btn-sm me-2"
                                    @onclick="SaveUser">
                                Save
                            </button>

                            <button class="btn btn-secondary btn-sm"
                                    @onclick="CancelEdit">
                                Cancel
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-warning btn-sm me-2"
                                    @onclick="() => StartEdit(user)">
                                Edit
                            </button>

                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => DeleteUser(user.Id)">
                                Delete
                            </button>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert alert-info">
            @Message
        </div>
    }
}

@code {

    private List<UserInfo> Clients = new();

    private List<TeacherInfo> Teachers = new();

    private RegisterRequest NewUser = new();

    private string SelectedRole = "All";

    private string Message = "";

    private int EditingUserId;

    private string EditUsername = "";
    private string EditEmail = "";
    private string EditRole = "";

    private int SelectedTeacherId;

    private string TeacherEmail = "";
    private string TeacherPassword = "";

    private IEnumerable<UserInfo> FilteredUsers =>
        SelectedRole == "All"
            ? Clients
            : Clients.Where(x => x.Role == SelectedRole);

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();

        Teachers =
            await ScheduleService.GetTeachersAsync();
    }

    private async Task LoadUsers()
    {
        Clients =
            await UserService.GetUsersAsync();
    }

    private async Task CreateUser()
    {
        if (string.IsNullOrWhiteSpace(NewUser.Username) ||
        string.IsNullOrWhiteSpace(NewUser.Email) ||
        string.IsNullOrWhiteSpace(NewUser.Password))
        {
            Message = "Please fill in all fields.";
            return;
        }

        try
        {
            await UserService.CreateUserAsync(NewUser);

            NewUser = new();

            Message = "User created successfully.";

            await LoadUsers();
        }
        catch (Exception ex)
        {
            Message = ex.Message;
        }
    }

    private async Task CreateTeacherAccount()
    {
        if (SelectedTeacherId == 0)
        {
            Message = "Please select a teacher.";
            return;
        }

        if (string.IsNullOrWhiteSpace(TeacherEmail) ||
            string.IsNullOrWhiteSpace(TeacherPassword))
        {
            Message = "Please fill in all fields.";
            return;
        }

        try
        {
            var teacher =
                Teachers.FirstOrDefault(
                    x => x.Id == SelectedTeacherId);

            if (teacher == null)
            {
                Message = "Please select a teacher.";
                return;
            }

            var request = new RegisterRequest
                {
                    Username = teacher.Name,
                    Email = TeacherEmail,
                    Password = TeacherPassword,
                    Role = "Teacher"
                };

            TeacherEmail = "";
            TeacherPassword = "";
            SelectedTeacherId = 0;

            var createdUser = await UserService.CreateUserAsync(request);

            if (createdUser == null)
            {
                Message = "Teacher username or email is already exitsts.";
                return;
            }

            await ScheduleService.UpdateTeacherAsync(teacher.Id, new UpdateTeacherRequest
                {
                    Name = teacher.Name,
                    Degree = teacher.Degree,
                    DepartmentId = teacher.DepartmentId,
                    UserId = createdUser.Id
                });

            Message = "Teacher account created successfully.";

            await LoadUsers();
        }
        catch (Exception ex)
        {
            Message = ex.Message;
        }
    }

    private void StartEdit(UserInfo user)
    {
        EditingUserId = user.Id;

        EditUsername = user.Username;
        EditEmail = user.Email;
        EditRole = user.Role;
    }

    private async Task SaveUser()
    {
        var request = new UpdateUserRequests
        {
            Username = EditUsername,
            Email = EditEmail,
            Role = EditRole
        };

        await UserService.UpdateUserAsync(
            EditingUserId,
            request);

        EditingUserId = 0;

        await LoadUsers();
    }

    private void CancelEdit()
    {
        EditingUserId = 0;
    }

    private async Task DeleteUser(int id)
    {
        await UserService.DeleteUserAsync(id);

        await LoadUsers();
    }
}