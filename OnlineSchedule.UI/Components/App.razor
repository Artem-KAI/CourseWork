<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <base href="/" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />

    <HeadOutlet @rendermode="new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode()" />
</head>

<body>
    <Routes @rendermode="new Microsoft.AspNetCore.Components.Web.InteractiveServerRenderMode()" />

    <script src="_framework/blazor.web.js"></script>
    <script>
        window.downloadFileFromBase64 = (filename, base64) => {
        const link = document.createElement('a');
        link.download = filename;
        link.href = 'data:text/csv;charset=utf-8;base64,' + base64;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        };
    </script>
</body>

</html>